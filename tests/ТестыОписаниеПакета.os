#Использовать asserts
#Использовать "../app"

&Тест
Процедура СвойстваВозвращаютЗаполненнуюСтруктуру() Экспорт

	Описание = Новый ОписаниеПакета();
	Описание.Имя("hub.oscript.io").Версия("3.0.0");

	Свойства = Описание.Свойства();

	Ожидаем.Что(Свойства.Имя).Равно("hub.oscript.io");
	Ожидаем.Что(Свойства.Версия).Равно("3.0.0");

КонецПроцедуры

&Тест
Процедура СвойстваПадаютБезИмени() Экспорт

	Описание = Новый ОписаниеПакета();
	Описание.Версия("1.0");

	Попытка
		Описание.Свойства();
		Ошибка = "";
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(Найти(Ошибка, "Не задано имя пакета") > 0).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СвойстваПадаютБезВерсии() Экспорт

	Описание = Новый ОписаниеПакета();
	Описание.Имя("foo");

	Попытка
		Описание.Свойства();
		Ошибка = "";
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(Найти(Ошибка, "Не задана версия пакета") > 0).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЗависитОтРегистрируетЗависимость() Экспорт

	Описание = Новый ОписаниеПакета();
	Описание.Имя("foo").Версия("1.0")
		.ЗависитОт("logos", "0.5", "0.9")
		.ЗависитОт("fs");

	Зависимости = Описание.Зависимости();

	Ожидаем.Что(Зависимости.Количество()).Равно(2);

	Logos = Зависимости.Найти("logos", "ИмяПакета");
	Ожидаем.Что(Logos).ЭтоНеНеопределено();
	Ожидаем.Что(Logos.МинимальнаяВерсия).Равно("0.5");
	Ожидаем.Что(Logos.МаксимальнаяВерсия).Равно("0.9");

	FS = Зависимости.Найти("fs", "ИмяПакета");
	Ожидаем.Что(FS).ЭтоНеНеопределено();

КонецПроцедуры

&Тест
Процедура ПовторныйЗависитОтНеДублирует() Экспорт

	Описание = Новый ОписаниеПакета();
	Описание.Имя("foo").Версия("1.0")
		.ЗависитОт("logos", "0.5")
		.ЗависитОт("logos", "0.6");

	Зависимости = Описание.Зависимости();

	Ожидаем.Что(Зависимости.Количество()).Равно(1);
	Ожидаем.Что(Зависимости[0].МинимальнаяВерсия).Равно("0.6");

КонецПроцедуры

&Тест
Процедура ОпределяетКлассДобавляетВКоллекциюКлассов() Экспорт

	Описание = Новый ОписаниеПакета();
	Описание.Имя("foo").Версия("1.0")
		.ОпределяетКласс("МойКласс", "src/Классы/МойКласс.os");

	Классы = Описание.Классы();

	Ожидаем.Что(Классы.Количество()).Равно(1);
	Ожидаем.Что(Классы[0].Идентификатор).Равно("МойКласс");

КонецПроцедуры

&Тест
Процедура ВключаемыеФайлыСохраняютПорядок() Экспорт

	Описание = Новый ОписаниеПакета();
	Описание.Имя("foo").Версия("1.0")
		.ВключитьФайл("a.txt")
		.ВключитьФайл("b.txt");

	Файлы = Описание.ВключаемыеФайлы();

	Ожидаем.Что(Файлы.Количество()).Равно(2);
	Ожидаем.Что(Файлы[0]).Равно("a.txt");
	Ожидаем.Что(Файлы[1]).Равно("b.txt");

КонецПроцедуры
