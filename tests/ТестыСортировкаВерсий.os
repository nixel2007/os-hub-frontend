#Использовать asserts
#Использовать "../app"

&Пластилин
Перем СортировкаВерсий;

&Тест
Процедура СортировкаПоВозрастаниюРаботаетКорректно() Экспорт

	Версии = Новый Массив;
	Версии.Добавить("0.2.0");
	Версии.Добавить("1.0.1");
	Версии.Добавить("1.0.0");
	Версии.Добавить("0.10.0");
	Версии.Добавить("0.1.1");

	СортировкаВерсий.СортироватьВерсии(Версии, "Возр");

	Ожидаем.Что(Версии.Количество()).Равно(5);
	Ожидаем.Что(Версии[0]).Равно("0.1.1");
	Ожидаем.Что(Версии[1]).Равно("0.2.0");
	Ожидаем.Что(Версии[2]).Равно("0.10.0");
	Ожидаем.Что(Версии[3]).Равно("1.0.0");
	Ожидаем.Что(Версии[4]).Равно("1.0.1");

КонецПроцедуры

&Тест
Процедура СортировкаПоУбываниюРаботаетКорректно() Экспорт

	Версии = Новый Массив;
	Версии.Добавить("1.0.0");
	Версии.Добавить("0.10.0");
	Версии.Добавить("2.0.0");
	Версии.Добавить("0.1.0");

	СортировкаВерсий.СортироватьВерсии(Версии, "Убыв");

	Ожидаем.Что(Версии[0]).Равно("2.0.0");
	Ожидаем.Что(Версии[1]).Равно("1.0.0");
	Ожидаем.Что(Версии[2]).Равно("0.10.0");
	Ожидаем.Что(Версии[3]).Равно("0.1.0");

КонецПроцедуры

&Тест
Процедура СортировкаУчитываетЧисловойПорядокСегментов() Экспорт

	// Ключевая для semver проверка: "0.10" должно быть больше "0.2".
	Версии = Новый Массив;
	Версии.Добавить("0.2");
	Версии.Добавить("0.10");

	СортировкаВерсий.СортироватьВерсии(Версии, "Возр");

	Ожидаем.Что(Версии[0]).Равно("0.2");
	Ожидаем.Что(Версии[1]).Равно("0.10");

КонецПроцедуры

&Тест
Процедура СортировкаОдногоЭлементаНеПадает() Экспорт

	Версии = Новый Массив;
	Версии.Добавить("1.2.3");

	СортировкаВерсий.СортироватьВерсии(Версии);

	Ожидаем.Что(Версии.Количество()).Равно(1);
	Ожидаем.Что(Версии[0]).Равно("1.2.3");

КонецПроцедуры

&Тест
Процедура СортировкаПустогоМассиваНеПадает() Экспорт

	Версии = Новый Массив;
	СортировкаВерсий.СортироватьВерсии(Версии);
	Ожидаем.Что(Версии.Количество()).Равно(0);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("1.0", "1.0", 0)
&ИсточникЗначение("1.0", "0.9", 1)
&ИсточникЗначение("0.9", "1.0", -1)
&ИсточникЗначение("0.10.0", "0.2.0", 1)
&ИсточникЗначение("1.0.0-beta", "1.0.0", -1)
Процедура СравнениеВерсийДаётОжидаемыйЗнак(А, Б, ОжидаемыйЗнак) Экспорт

	// Косвенно проверяется через сортировку: после сортировки по возр.
	// меньшая версия должна оказаться слева.
	Массив = Новый Массив;
	Массив.Добавить(А);
	Массив.Добавить(Б);
	СортировкаВерсий.СортироватьВерсии(Массив, "Возр");

	Если ОжидаемыйЗнак = 0 Тогда
		Ожидаем.Что(Массив[0]).Равно(Массив[1]);
	ИначеЕсли ОжидаемыйЗнак > 0 Тогда
		Ожидаем.Что(Массив[0]).Равно(Б);
		Ожидаем.Что(Массив[1]).Равно(А);
	Иначе
		Ожидаем.Что(Массив[0]).Равно(А);
		Ожидаем.Что(Массив[1]).Равно(Б);
	КонецЕсли;

КонецПроцедуры
