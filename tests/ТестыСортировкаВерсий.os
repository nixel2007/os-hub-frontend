#Использовать asserts
#Использовать "../app"

Перем СортировкаВерсий;

&ПередКаждым
Процедура ПередКаждым() Экспорт
	СортировкаВерсий = Новый СортировкаВерсий();
КонецПроцедуры

&Тест
Процедура СортировкаПоВозрастаниюРаботаетКорректно() Экспорт

	Список = Новый Массив;
	Список.Добавить("0.2.0");
	Список.Добавить("1.0.1");
	Список.Добавить("1.0.0");
	Список.Добавить("0.10.0");
	Список.Добавить("0.1.1");

	СортировкаВерсий.СортироватьВерсии(Список, "Возр");

	Ожидаем.Что(Список.Количество()).Равно(5);
	Ожидаем.Что(Список[0]).Равно("0.1.1");
	Ожидаем.Что(Список[1]).Равно("0.2.0");
	Ожидаем.Что(Список[2]).Равно("0.10.0");
	Ожидаем.Что(Список[3]).Равно("1.0.0");
	Ожидаем.Что(Список[4]).Равно("1.0.1");

КонецПроцедуры

&Тест
Процедура СортировкаПоУбываниюРаботаетКорректно() Экспорт

	Список = Новый Массив;
	Список.Добавить("1.0.0");
	Список.Добавить("0.10.0");
	Список.Добавить("2.0.0");
	Список.Добавить("0.1.0");

	СортировкаВерсий.СортироватьВерсии(Список, "Убыв");

	Ожидаем.Что(Список[0]).Равно("2.0.0");
	Ожидаем.Что(Список[1]).Равно("1.0.0");
	Ожидаем.Что(Список[2]).Равно("0.10.0");
	Ожидаем.Что(Список[3]).Равно("0.1.0");

КонецПроцедуры

&Тест
Процедура СортировкаУчитываетЧисловойПорядокСегментов() Экспорт

	// Ключевая для semver проверка: "0.10" должно быть больше "0.2".
	Список = Новый Массив;
	Список.Добавить("0.2");
	Список.Добавить("0.10");

	СортировкаВерсий.СортироватьВерсии(Список, "Возр");

	Ожидаем.Что(Список[0]).Равно("0.2");
	Ожидаем.Что(Список[1]).Равно("0.10");

КонецПроцедуры

&Тест
Процедура СортировкаОдногоЭлементаНеПадает() Экспорт

	Список = Новый Массив;
	Список.Добавить("1.2.3");

	СортировкаВерсий.СортироватьВерсии(Список);

	Ожидаем.Что(Список.Количество()).Равно(1);
	Ожидаем.Что(Список[0]).Равно("1.2.3");

КонецПроцедуры

&Тест
Процедура СортировкаПустогоМассиваНеПадает() Экспорт

	Список = Новый Массив;
	СортировкаВерсий.СортироватьВерсии(Список);
	Ожидаем.Что(Список.Количество()).Равно(0);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("1.0", "1.0", 0)
&ИсточникЗначение("1.0", "0.9", 1)
&ИсточникЗначение("0.9", "1.0", -1)
&ИсточникЗначение("0.10.0", "0.2.0", 1)
Процедура СравнениеВерсийДаётОжидаемыйЗнак(А, Б, ОжидаемыйЗнак) Экспорт

	// Косвенно проверяется через сортировку: после сортировки по возр.
	// меньшая версия должна оказаться слева.
	Массив = Новый Массив;
	Массив.Добавить(А);
	Массив.Добавить(Б);
	СортировкаВерсий.СортироватьВерсии(Массив, "Возр");

	Если ОжидаемыйЗнак = 0 Тогда
		Ожидаем.Что(Массив[0]).Равно(Массив[1]);
	ИначеЕсли ОжидаемыйЗнак > 0 Тогда
		Ожидаем.Что(Массив[0]).Равно(Б);
		Ожидаем.Что(Массив[1]).Равно(А);
	Иначе
		Ожидаем.Что(Массив[0]).Равно(А);
		Ожидаем.Что(Массив[1]).Равно(Б);
	КонецЕсли;

КонецПроцедуры
