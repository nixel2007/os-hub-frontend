#Использовать asserts
#Использовать moskito
#Использовать "../app"

// СервисКонтента инжектит ХранилищеПакетов / ХранилищеВерсий, которые
// autumn-data собирает поверх МенеджераСущностей. В тестовом окружении
// данные источники не настроены, поэтому собираем сервис вручную и
// подсовываем moskito-моки в его поля.

Перем Сервис;
Перем МокХранилищаПакетов;
Перем МокХранилищаВерсий;
Перем МокКонфигурации;

&ПередКаждым
Процедура ПередКаждым() Экспорт

	Сервис = Новый СервисКонтента();

	МокХранилищаПакетов = Мок.Получить(Тип("ХранилищеПакетов"));
	МокХранилищаВерсий = Мок.Получить(Тип("ХранилищеВерсий"));
	МокКонфигурации = Мок.Получить(Тип("КонфигурацияХаба"));
	МокКонфигурации.КаталогПакетов = "download";
	МокКонфигурации.Когда().КаталогХраненияПакетов().ТогдаВозвращает("/tmp/packages");

	Сервис.ХранилищеПакетов = МокХранилищаПакетов;
	Сервис.ХранилищеВерсий = МокХранилищаВерсий;
	Сервис.КонфигурацияХаба = МокКонфигурации;
	Сервис.СортировкаВерсий = Новый СортировкаВерсий();

КонецПроцедуры

Функция СоздатьПакет(Знач Код, Знач Название = Неопределено, Знач Описание = "", Знач КС = "") Экспорт
	Пакет = Новый Пакет;
	Пакет.Код = Код;
	Пакет.Название = ?(Название = Неопределено, Код, Название);
	Пакет.Описание = Описание;
	Пакет.КлючевыеСлова = КС;
	Пакет.СсылкаНаПроект = "https://github.com/oscript-library/" + Код;
	Пакет.АктуальнаяВерсия = "1.0.0";
	Возврат Пакет;
КонецФункции

&Тест
Процедура ТаблицаПакетовВозвращаетВсеЗаписиИзРепозитория() Экспорт

	Пакеты = Новый Массив;
	Пакеты.Добавить(СоздатьПакет("logos"));
	Пакеты.Добавить(СоздатьПакет("fs"));

	МокХранилищаПакетов.Когда().Все().ТогдаВозвращает(Пакеты);

	Таблица = Сервис.ТаблицаПакетов();

	Ожидаем.Что(Таблица.Количество()).Равно(2);
	Ожидаем.Что(Таблица[0].ИмяПакета).Равно("logos");
	Ожидаем.Что(Таблица[0].АдресРепозитория).Равно("https://github.com/oscript-library/logos");
	Ожидаем.Что(Таблица[1].ИмяПакета).Равно("fs");

КонецПроцедуры

&Тест
Процедура ПоискПакетовПоПодстрокеНазвания() Экспорт

	Пакеты = Новый Массив;
	Пакеты.Добавить(СоздатьПакет("vanessa-runner"));
	Пакеты.Добавить(СоздатьПакет("logos"));
	Пакеты.Добавить(СоздатьПакет("vanessa-tester"));

	МокХранилищаПакетов.Когда().Все().ТогдаВозвращает(Пакеты);

	Найденные = Сервис.ПоискПакетов("vanessa");

	Ожидаем.Что(Найденные.Количество()).Равно(2);
	Ожидаем.Что(Найденные[0].Название).Равно("vanessa-runner");
	Ожидаем.Что(Найденные[1].Название).Равно("vanessa-tester");

КонецПроцедуры

&Тест
Процедура ПоискПакетовПоОписаниюИКлючевымСловам() Экспорт

	Пакеты = Новый Массив;
	Пакеты.Добавить(СоздатьПакет("a", "a", "Logging library", "log,utility"));
	Пакеты.Добавить(СоздатьПакет("b", "b", "File system helpers", "files"));
	Пакеты.Добавить(СоздатьПакет("c", "c", "Random text", "log"));

	МокХранилищаПакетов.Когда().Все().ТогдаВозвращает(Пакеты);

	Найденные = Сервис.ПоискПакетов("log");

	Ожидаем.Что(Найденные.Количество()).Равно(2);

КонецПроцедуры

&Тест
Процедура ПоискПакетовСПустойСтрокойВозвращаетВсех() Экспорт

	Пакеты = Новый Массив;
	Пакеты.Добавить(СоздатьПакет("a"));
	Пакеты.Добавить(СоздатьПакет("b"));

	МокХранилищаПакетов.Когда().Все().ТогдаВозвращает(Пакеты);

	Найденные = Сервис.ПоискПакетов("");

	Ожидаем.Что(Найденные.Количество()).Равно(2);

КонецПроцедуры

&Тест
Процедура ДанныеПакетаПоНеизвестномуКодуВозвращаютПустуюСтруктуру() Экспорт

	МокХранилищаПакетов.Когда().НайтиПоКоду(Матчеры.ЛюбоеЗначение()).ТогдаВозвращает(Неопределено);

	Данные = Сервис.ДанныеПакетаПоКоду("несуществующий");

	Ожидаем.Что(Данные.Название = Неопределено).ЭтоИстина();
	Ожидаем.Что(Данные.Версии.Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ДанныеПакетаСортируютВерсииПоУбыванию() Экспорт

	Пакет = СоздатьПакет("logos");

	Версия1 = Новый ВерсияПакета;
	Версия1.Номер = "0.5";
	Версия1.ДатаОбновления = '20240101';

	Версия2 = Новый ВерсияПакета;
	Версия2.Номер = "0.10";
	Версия2.ДатаОбновления = '20240301';

	Версия3 = Новый ВерсияПакета;
	Версия3.Номер = "0.2";
	Версия3.ДатаОбновления = '20231101';

	Массив = Новый Массив;
	Массив.Добавить(Версия1);
	Массив.Добавить(Версия2);
	Массив.Добавить(Версия3);

	МокХранилищаПакетов.Когда().НайтиПоКоду("logos").ТогдаВозвращает(Пакет);
	МокХранилищаВерсий.Когда().Версии("logos").ТогдаВозвращает(Массив);

	Данные = Сервис.ДанныеПакетаПоКоду("logos");

	Ожидаем.Что(Данные.Версии.Количество()).Равно(3);
	Ожидаем.Что(Данные.Версии[0].НомерВерсии).Равно("0.10");
	Ожидаем.Что(Данные.Версии[1].НомерВерсии).Равно("0.5");
	Ожидаем.Что(Данные.Версии[2].НомерВерсии).Равно("0.2");

КонецПроцедуры

&Тест
Процедура ПолучитьСодержимоеReadmeВозвращаетЗаглушкуДляПустогоПути() Экспорт
	Результат = Сервис.ПолучитьСодержимоеReadme("");
	Ожидаем.Что(Найти(Результат, "Автор не предоставил") > 0).ЭтоИстина();
КонецПроцедуры

&Тест
Процедура ПолучитьСодержимоеReadmeВозвращаетЗаглушкуЕслиФайлаНет() Экспорт
	Результат = Сервис.ПолучитьСодержимоеReadme("/каталог/которого/точно/нет");
	Ожидаем.Что(Найти(Результат, "Автор не предоставил") > 0).ЭтоИстина();
КонецПроцедуры
