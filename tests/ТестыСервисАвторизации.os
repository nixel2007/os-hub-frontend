#Использовать asserts
#Использовать moskito
#Использовать "../app"

Перем Сервис;

&ПередКаждым
Процедура ПередКаждым() Экспорт
	Сервис = Новый СервисАвторизации();
	Конфиг = Мок.Получить(Тип("КонфигурацияХаба"));
	// moskito переносит свойства мокируемого объекта, поэтому
	// прямое присваивание полю работает.
	Конфиг.ЛогинАдмина = "admin";
	Конфиг.ПарольАдмина = "secret";
	Сервис.КонфигурацияХаба = Конфиг;
КонецПроцедуры

&Тест
Процедура АвторизованВозвращаетЛожьДляПустойСессии() Экспорт
	Сессия = Новый Соответствие;
	Ожидаем.Что(Сервис.Авторизован(Сессия)).ЭтоЛожь();
КонецПроцедуры

&Тест
Процедура АвторизованВозвращаетЛожьДляНеопределеннойСессии() Экспорт
	Ожидаем.Что(Сервис.Авторизован(Неопределено)).ЭтоЛожь();
КонецПроцедуры

&Тест
Процедура ПослеВходаСессияСчитаетсяАвторизованной() Экспорт

	Сессия = Новый Соответствие;
	Сервис.Войти(Сессия, "admin");

	Ожидаем.Что(Сервис.Авторизован(Сессия)).ЭтоИстина();
	Ожидаем.Что(Сессия["ИмяПользователя"]).Равно("admin");

КонецПроцедуры

&Тест
Процедура ПослеВыходаСессияНеАвторизована() Экспорт

	Сессия = Новый Соответствие;
	Сервис.Войти(Сессия, "admin");
	Сервис.Выйти(Сессия);

	Ожидаем.Что(Сервис.Авторизован(Сессия)).ЭтоЛожь();
	Ожидаем.Что(Сессия["ИмяПользователя"] = Неопределено).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПроверитьВходСРавнымиЛогиномИПаролемВозвращаетИстину() Экспорт
	Ожидаем.Что(Сервис.ПроверитьВход("admin", "secret")).ЭтоИстина();
КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("admin", "wrong")
&ИсточникЗначение("hacker", "secret")
&ИсточникЗначение("", "")
Процедура ПроверитьВходСНевернымиДаннымиВозвращаетЛожь(Имя, Пароль) Экспорт
	Ожидаем.Что(Сервис.ПроверитьВход(Имя, Пароль)).ЭтоЛожь();
КонецПроцедуры
