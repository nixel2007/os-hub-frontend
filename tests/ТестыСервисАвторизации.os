#Использовать asserts
#Использовать moskito
#Использовать "../app"

&Пластилин
Перем СервисАвторизации;

&Пластилин
Перем КонфигурацияХаба;

// Подменяем настоящую КонфигурацияХаба на мок, чтобы не зависеть от
// переменных среды и иметь возможность задать ожидаемые логин/пароль.
&Завязь
&Верховный
&Прозвище("КонфигурацияХаба")
Функция ТестоваяКонфигурация() Экспорт
	Конфиг = Мок.Получить(Тип("КонфигурацияХаба"));
	Конфиг.Когда().ЛогинАдмина.ТогдаВозвращает("admin");
	Конфиг.Когда().ПарольАдмина.ТогдаВозвращает("secret");
	Возврат Конфиг;
КонецФункции

&Тест
Процедура АвторизованВозвращаетЛожьДляПустойСессии() Экспорт
	Сессия = Новый Соответствие;
	Ожидаем.Что(СервисАвторизации.Авторизован(Сессия)).ЭтоЛожь();
КонецПроцедуры

&Тест
Процедура АвторизованВозвращаетЛожьДляНеопределеннойСессии() Экспорт
	Ожидаем.Что(СервисАвторизации.Авторизован(Неопределено)).ЭтоЛожь();
КонецПроцедуры

&Тест
Процедура ПослеВходаСессияСчитаетсяАвторизованной() Экспорт

	Сессия = Новый Соответствие;
	СервисАвторизации.Войти(Сессия, "admin");

	Ожидаем.Что(СервисАвторизации.Авторизован(Сессия)).ЭтоИстина();
	Ожидаем.Что(Сессия["ИмяПользователя"]).Равно("admin");

КонецПроцедуры

&Тест
Процедура ПослеВыходаСессияНеАвторизована() Экспорт

	Сессия = Новый Соответствие;
	СервисАвторизации.Войти(Сессия, "admin");
	СервисАвторизации.Выйти(Сессия);

	Ожидаем.Что(СервисАвторизации.Авторизован(Сессия)).ЭтоЛожь();
	Ожидаем.Что(Сессия["ИмяПользователя"]).ЭтоНеопределено();

КонецПроцедуры

&Тест
Процедура ПроверитьВходСРавнымиЛогиномИПаролемВозвращаетИстину() Экспорт
	Ожидаем.Что(СервисАвторизации.ПроверитьВход("admin", "secret")).ЭтоИстина();
КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("admin", "wrong")
&ИсточникЗначение("hacker", "secret")
&ИсточникЗначение("", "")
Процедура ПроверитьВходСНевернымиДаннымиВозвращаетЛожь(Имя, Пароль) Экспорт
	Ожидаем.Что(СервисАвторизации.ПроверитьВход(Имя, Пароль)).ЭтоЛожь();
КонецПроцедуры
