#Использовать asserts
#Использовать "../app"

&Пластилин
Перем СервисПубликации;

&ПараметризованныйТест
&ИсточникЗначение("logos-0.5.1.ospx", "logos", "0.5.1")
&ИсточникЗначение("vanessa-runner-1.2.3.ospx", "vanessa-runner", "1.2.3")
&ИсточникЗначение("hub.oscript.io-3.0.0.beta.ospx", "hub.oscript.io", "3.0.0.beta")
&ИсточникЗначение("foo-SNAPSHOT.ospx", "foo", "SNAPSHOT")
Процедура ОписаниеПакетаРазбираетИмяФайла(ИмяФайла, ОжидаемоеИмя, ОжидаемаяВерсия) Экспорт

	Описание = СервисПубликации.ОписаниеПакета(ИмяФайла);

	Ожидаем.Что(Описание.Идентификатор).Равно(ОжидаемоеИмя);
	Ожидаем.Что(Описание.Версия).Равно(ОжидаемаяВерсия);

КонецПроцедуры

&Тест
Процедура ПроверитьКорректностьФайлаПринимаетOspx() Экспорт

	Попытка
		СервисПубликации.ПроверитьКорректностьФайла("foo-1.0.ospx");
		Упало = Ложь;
	Исключение
		Упало = Истина;
	КонецПопытки;

	Ожидаем.Что(Упало).ЭтоЛожь();

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("foo-1.0.zip")
&ИсточникЗначение("foo-1.0")
&ИсточникЗначение("foo.ospx.bak")
Процедура ПроверитьКорректностьФайлаОтклоняетНеOspx(ИмяФайла) Экспорт

	Попытка
		СервисПубликации.ПроверитьКорректностьФайла(ИмяФайла);
		Упало = Ложь;
	Исключение
		Упало = Истина;
	КонецПопытки;

	Ожидаем.Что(Упало).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ВычислитьКодОшибкиВозвращает500ПриОтсутствииПараметров() Экспорт

	Попытка
		ВызватьИсключение "Ошибка без параметра";
	Исключение
		Инфо = ИнформацияОбОшибке();
	КонецПопытки;

	Ожидаем.Что(СервисПубликации.ВычислитьКодОшибки(Инфо)).Равно(500);

КонецПроцедуры

&Тест
Процедура ВычислитьКодОшибкиВозвращаетКодИзПараметров() Экспорт

	Попытка
		ВызватьИсключение Новый ИнформацияОбОшибке("Не авторизован", 401);
	Исключение
		Инфо = ИнформацияОбОшибке();
	КонецПопытки;

	Ожидаем.Что(СервисПубликации.ВычислитьКодОшибки(Инфо)).Равно(401);

КонецПроцедуры
