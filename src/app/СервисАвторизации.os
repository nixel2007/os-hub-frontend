// Простейший сервис проверки авторизации админки.
// Логин/пароль приходят из окружения через КонфигурацияХаба.
// Признак авторизации хранится в данных сессии winow.

&Пластилин
Перем КонфигурацияХаба;

&Желудь
&Прозвище("СервисАвторизации")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

Функция ПроверитьВход(Знач Имя, Знач Пароль) Экспорт
	Возврат Имя = КонфигурацияХаба.ЛогинАдмина И Пароль = КонфигурацияХаба.ПарольАдмина;
КонецФункции

Процедура Войти(Знач ДанныеСессии, Знач Имя) Экспорт
	ДанныеСессии["Авторизован"] = Истина;
	ДанныеСессии["ИмяПользователя"] = Имя;
КонецПроцедуры

Процедура Выйти(Знач ДанныеСессии) Экспорт
	ДанныеСессии.Удалить("Авторизован");
	ДанныеСессии.Удалить("ИмяПользователя");
КонецПроцедуры

Функция Авторизован(Знач ДанныеСессии) Экспорт
	Если ДанныеСессии = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ДанныеСессии["Авторизован"] = Истина;
КонецФункции
