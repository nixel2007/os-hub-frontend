#Использовать fs
#Использовать github

&Пластилин
Перем КонфигурацияХаба;

&Пластилин
Перем ХранилищеПакетов;

&Пластилин
Перем ХранилищеВерсий;

&Пластилин
Перем ХранилищеЗависимостей;

&Пластилин
Перем ХранилищеАвторов;

&Пластилин
Перем СортировкаВерсий;

&Желудь
&Прозвище("СервисПубликации")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

Функция ПроверитьКорректностьФайла(Знач ИмяФайла) Экспорт
	Если Не СтрЗаканчиваетсяНа(ИмяФайла, ".ospx") Тогда
		ВызватьИсключение Новый ИнформацияОбОшибке(
			"Недопустимое расширение файла пакета. Допускаются только файлы ospx.", 401);
	КонецЕсли;
КонецФункции

Функция ОписаниеПакета(Знач ИмяФайла) Экспорт
	Описание = Новый Структура;
	Описание.Вставить("Идентификатор", ИмяПакетаИзИмениФайла(ИмяФайла));
	Описание.Вставить("Версия", ВерсияПакетаИзИмениФайла(ИмяФайла));
	Возврат Описание;
КонецФункции

Функция ПользовательGitHubПоТокену(Знач Токен) Экспорт
	Клиент = Новый КлиентGitHub(Токен);
	Возврат Клиент.ПолучитьПользователя(Новый ПользовательGitHub());
КонецФункции

Функция ЕстьРазрешениеОтправлятьВРепозиторий(Знач ИмяПользователя, Знач ИмяРепозитория) Экспорт
	Результат = Ложь;
	Клиент = Новый КлиентGitHub(КонфигурацияХаба.ТокенGitHubСупер);
	Сотрудники = Клиент.ПолучитьСотрудниковРепозитория("oscript-library", ИмяРепозитория);
	Для Каждого Сотрудник Из Сотрудники Цикл
		Если Сотрудник.Логин = ИмяПользователя Тогда
			Результат = Сотрудник.Разрешения.Отправка;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ЗафиксироватьПакет(Знач Каталог, Знач ДвоичныеДанные, Знач ИмяФайла, Знач ОписаниеПакета, Знач ЭтоТестоваяСборка) Экспорт

	ПутьККаталогуПакета = ОбъединитьПути(Каталог, ОписаниеПакета.Идентификатор);
	ФС.ОбеспечитьКаталог(ПутьККаталогуПакета);

	ИтоговоеИмя = ИмяФайла;
	Если ЭтоТестоваяСборка Тогда
		ИтоговоеИмя = СтрШаблон("%1-SNAPSHOT.ospx", ОписаниеПакета.Идентификатор);
	Иначе
		ДвоичныеДанные.Записать(ОбъединитьПути(ПутьККаталогуПакета, ОписаниеПакета.Идентификатор + ".ospx"));
	КонецЕсли;

	ПутьКФайлу = ОбъединитьПути(ПутьККаталогуПакета, ИтоговоеИмя);
	ДвоичныеДанные.Записать(ПутьКФайлу);

	Пакет = ЗафиксироватьПакетВБД(ОписаниеПакета, ПутьККаталогуПакета, ИтоговоеИмя, ЭтоТестоваяСборка);
	СформироватьList(Каталог);

	Возврат Пакет;

КонецФункции

Функция ЗафиксироватьПакетВБД(Знач ОписаниеПакета, Знач ПутьККаталогуПакета, Знач ИмяФайла, Знач ЭтоТестоваяСборка)

	Идентификатор = ОписаниеПакета.Идентификатор;
	ТекущаяДата = ТекущаяДата();

	Пакет = ХранилищеПакетов.НайтиПоКоду(Идентификатор);
	Если Пакет = Неопределено Тогда
		Пакет = ХранилищеПакетов.Создать();
		Пакет.Код = Идентификатор;
		Пакет.Название = Пакет.Код;
		Пакет.Путь = ОбъединитьПути(КонфигурацияХаба.КаталогПакетов, Пакет.Код);
		Пакет.ДатаСоздания = ТекущаяДата;
		ХранилищеПакетов.Сохранить(Пакет);
	КонецЕсли;

	МетаданныеПакета = ПолучитьМетаданные(ОбъединитьПути(ПутьККаталогуПакета, ИмяФайла));

	АвторИмя = "";
	МетаданныеПакета.Свойство("Автор", АвторИмя);
	Если ЗначениеЗаполнено(АвторИмя) Тогда
		Пакет.Автор = ХранилищеАвторов.НайтиИлиСоздать(АвторИмя);
	КонецЕсли;

	АдресРепозитория = Неопределено;
	МетаданныеПакета.Свойство("АдресРепозитория", АдресРепозитория);
	Если ЗначениеЗаполнено(АдресРепозитория) Тогда
		Пакет.СсылкаНаПроект = АдресРепозитория;
	ИначеЕсли Не ЗначениеЗаполнено(Пакет.СсылкаНаПроект) Тогда
		Пакет.СсылкаНаПроект = СсылкаНаПроектПоПакету(Пакет);
	КонецЕсли;

	Пакет.ДатаОбновления = ТекущаяДата;

	Зависимости = ПрочитатьЗависимостиПакета(ОбъединитьПути(ПутьККаталогуПакета, ИмяФайла));
	НомерВерсии = ?(ЭтоТестоваяСборка, "SNAPSHOT", ОписаниеПакета.Версия);

	ВерсияПакета = ХранилищеВерсий.НайтиВерсиюПакета(Пакет.Код, НомерВерсии);
	Если ВерсияПакета = Неопределено Тогда
		ВерсияПакета = ХранилищеВерсий.Создать();
		ВерсияПакета.Номер = НомерВерсии;
		ВерсияПакета.Пакет = Пакет.Код;
		ВерсияПакета.Путь = ОбъединитьПути(КонфигурацияХаба.КаталогПакетов, Пакет.Код, ИмяФайла);
		ВерсияПакета.ДатаСоздания = ТекущаяДата;
	КонецЕсли;

	ВерсияПакета.ТестоваяСборка = ЭтоТестоваяСборка;
	ВерсияПакета.ДатаОбновления = ТекущаяДата;
	ВерсияПакета.Зависимости = СоздатьЗависимостиВерсии(Зависимости);
	ХранилищеВерсий.Сохранить(ВерсияПакета);

	Если Не ЭтоТестоваяСборка Тогда
		НоваяАктуальная = ОпределитьАктуальнуюВерсию(Пакет.Код);
		Если НоваяАктуальная <> Неопределено Тогда
			Пакет.АктуальнаяВерсия = НоваяАктуальная;
		КонецЕсли;
	КонецЕсли;

	ХранилищеПакетов.Сохранить(Пакет);

	Возврат Пакет;

КонецФункции

Функция ОпределитьАктуальнуюВерсию(Знач КодПакета) Экспорт
	Версии = ХранилищеВерсий.Версии(КодПакета);
	Массив = Новый Массив;
	Для Каждого Версия Из Версии Цикл
		Массив.Добавить(Версия.Номер);
	КонецЦикла;
	Попытка
		СортировкаВерсий.СортироватьВерсии(Массив, "Возр");
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Если Массив.Количество() > 0 Тогда
		Возврат Массив[Массив.ВГраница()];
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция СоздатьЗависимостиВерсии(Знач Зависимости)
	Массив = Новый Массив;
	Для Каждого СтрокаЗависимость Из Зависимости Цикл
		Зависимость = ХранилищеЗависимостей.Создать();
		Зависимость.Пакет = СтрокаЗависимость.Пакет;
		Зависимость.Версия = СтрокаЗависимость.Версия;
		Зависимость.МаксимальнаяВерсия = СтрокаЗависимость.МаксимальнаяВерсия;
		ХранилищеЗависимостей.Сохранить(Зависимость);
		Массив.Добавить(Зависимость);
	КонецЦикла;
	Возврат Массив;
КонецФункции

Функция ВычислитьКодОшибки(Знач ИнфоОшибки) Экспорт
	Параметры = ИнфоОшибки.Параметры;
	Если Параметры = Неопределено Тогда
		Параметры = 500;
	КонецЕсли;
	Возврат Параметры;
КонецФункции

Функция ПолучитьМетаданные(Знач ФайлПакета)
	Чтение = Новый РаботаСФайламиПакетов;
	Возврат Чтение.ПрочитатьМетаданныеПакета(ФайлПакета).Свойства();
КонецФункции

Функция ИмяПакетаИзИмениФайла(Знач ИмяФайла)
	Части = СтрРазделить(ИмяФайла, "-");
	Имя = "";
	Для Сч = 0 По Части.ВГраница() - 1 Цикл
		Имя = Имя + Части[Сч] + "-";
	КонецЦикла;
	Возврат Лев(Имя, СтрДлина(Имя) - 1);
КонецФункции

Функция ВерсияПакетаИзИмениФайла(Знач ИмяФайла)
	Части = СтрРазделить(ИмяФайла, "-");
	Версия = Части[Части.ВГраница()];
	Возврат СтрЗаменить(Версия, ".ospx", "");
КонецФункции

Функция СсылкаНаПроектПоПакету(Знач Пакет)

	Сервер = "https://github.com";
	Соединение = Новый HTTPСоединение(Сервер);
	Адрес = СтрШаблон("oscript-library/%1", Пакет.ИмяПроекта);

	Запрос = Новый HTTPЗапрос(Адрес);
	Ответ = Соединение.Получить(Запрос);

	Если Ответ.КодСостояния = 200 Тогда
		Возврат Сервер + "/" + Адрес;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция ПрочитатьЗависимостиПакета(Знач ИмяФайла) Экспорт

	Коллекция = Новый Массив;
	Архив = Новый ЧтениеZipФайла();
	Попытка
		Архив.Открыть(ИмяФайла, , КодировкаИменФайловВZipФайле.UTF8);
	Исключение
		Возврат Коллекция;
	КонецПопытки;

	Манифест = Архив.Элементы.Найти("opm-metadata.xml");
	Если Манифест = Неопределено Тогда
		Архив.Закрыть();
		Возврат Коллекция;
	КонецЕсли;

	ВременныйКаталог = ПолучитьИмяВременногоФайла();
	СоздатьКаталог(ВременныйКаталог);
	Архив.Извлечь(Манифест, ВременныйКаталог);
	Архив.Закрыть();

	ПутьКМетаданным = ОбъединитьПути(ВременныйКаталог, "opm-metadata.xml");

	Чтение = Новый ЧтениеXML();
	Попытка
		Чтение.ОткрытьФайл(ПутьКМетаданным);
		Пока Чтение.Прочитать() Цикл
			Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента И Чтение.Имя = "depends-on" Тогда
				Зависимость = Новый Структура("Пакет, Версия, МаксимальнаяВерсия");
				Зависимость.Пакет = Чтение.ЗначениеАтрибута("name");
				Зависимость.Версия = Чтение.ЗначениеАтрибута("version");
				Если Не ЗначениеЗаполнено(Зависимость.Версия) Тогда
					Зависимость.Версия = "0";
				КонецЕсли;
				Зависимость.МаксимальнаяВерсия = "999";
				Коллекция.Добавить(Зависимость);
			КонецЕсли;
		КонецЦикла;
	Исключение
	КонецПопытки;
	Чтение.Закрыть();

	Попытка
		УдалитьФайлы(ВременныйКаталог);
	Исключение
	КонецПопытки;

	Возврат Коллекция;

КонецФункции

Процедура СформироватьList(Знач КаталогПубликации)
	ПутьКСписку = ОбъединитьПути(КаталогПубликации, "list.txt");
	Найденные = НайтиФайлы(КаталогПубликации, ПолучитьМаскуВсеФайлы(), Ложь);
	Запись = Новый ЗаписьТекста(ПутьКСписку, КодировкаТекста.UTF8NoBom);
	Для Каждого Файл Из Найденные Цикл
		Если Файл.ЭтоФайл() Тогда
			Продолжить;
		КонецЕсли;
		Запись.ЗаписатьСтроку(Файл.Имя);
	КонецЦикла;
	Запись.Закрыть();
КонецПроцедуры

Функция ДвоичныеДанныеИзЗапроса(Знач Запрос) Экспорт
	Если Запрос.ТелоДвоичныеДанные <> Неопределено Тогда
		Возврат Запрос.ТелоДвоичныеДанные;
	КонецЕсли;
	Возврат ПолучитьДвоичныеДанныеИзСтроки(Запрос.Тело);
КонецФункции
