#Использовать autumn
#Использовать autumn-data
#Использовать winow

// Динамическая конфигурация источника данных Postgres из переменной среды,
// чтобы не требовать перезаписи autumn-properties.json при каждом старте.
СтрокаПодключения = ПолучитьПеременнуюСреды("OSWEB_DATABASE__CONNECTIONSTRING");
Если ПустаяСтрока(СтрокаПодключения) Тогда
	ВызватьИсключение "Не задана строка подключения к БД (OSWEB_DATABASE__CONNECTIONSTRING)";
КонецЕсли;

Если ПустаяСтрока(ПолучитьПеременнуюСреды("OSHUB_BINARY_ROOT")) Тогда
	ВызватьИсключение "Не задан каталог хранения пакетов OSPX (OSHUB_BINARY_ROOT)";
КонецЕсли;

Детальки = Новый Соответствие();

СекцияData = Новый Соответствие();
ИсточникДанных = Новый Соответствие();
ИсточникДанных.Вставить("ТипКоннектора", "КоннекторPostgreSQL");
ИсточникДанных.Вставить("СтрокаСоединения", СтрокаПодключения);
СекцияData.Вставить("ИсточникиДанных", ИсточникДанных);
Детальки.Вставить("data", СекцияData);

СоветДругогоМастера = Новый СоветДругогоМастера();
СоветДругогоМастера.ЗначенияДеталек(Детальки);

Поделка = Новый Поделка(СоветДругогоМастера);
Поделка.ЗапуститьПриложение();
