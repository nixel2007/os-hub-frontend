#Использовать fs
// TODO: вернуть рендеринг через markdown, когда соберётся MdRenderProxy.
// #Использовать markdown

&Пластилин
Перем КонфигурацияХаба Экспорт;

&Пластилин
Перем ХранилищеПакетов Экспорт;

&Пластилин
Перем ХранилищеВерсий Экспорт;

&Пластилин
Перем СортировкаВерсий Экспорт;

&Желудь
&Прозвище("СервисКонтента")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

// Возвращает таблицу пакетов с агрегированными данными для отображения списка.
Функция ТаблицаПакетов() Экспорт

	Таблица = ШаблонТаблицыПакетов();

	Пакеты = ХранилищеПакетов.Все();
	Для Каждого Пакет Из Пакеты Цикл
		Стр = Таблица.Добавить();
		Стр.ИмяПакета = Пакет.Код;
		Стр.Название = Пакет.Название;
		Стр.Описание = Пакет.Описание;
		Стр.КлючевыеСлова = Пакет.КлючевыеСлова;
		Стр.АдресРепозитория = Пакет.СсылкаНаПроект;
		Стр.АктуальнаяВерсия = Пакет.АктуальнаяВерсия;
		Если ЗначениеЗаполнено(Пакет.Автор) Тогда
			Стр.Автор = Пакет.Автор.Имя;
		КонецЕсли;
	КонецЦикла;

	Возврат Таблица;

КонецФункции

Функция ПоискПакетов(Знач Текст) Экспорт
	Все = ТаблицаПакетов();
	Если ПустаяСтрока(Текст) Тогда
		Возврат Все;
	КонецЕсли;
	Найденные = Все.Скопировать();
	Найденные.Очистить();
	Для Каждого Стр Из Все Цикл
		Если Найти(Строка(Стр.Название), Текст) > 0
			Или Найти(Строка(Стр.Описание), Текст) > 0
			Или Найти(Строка(Стр.КлючевыеСлова), Текст) > 0 Тогда
			ЗаполнитьЗначенияСвойств(Найденные.Добавить(), Стр);
		КонецЕсли;
	КонецЦикла;
	Возврат Найденные;
КонецФункции

Функция ШаблонТаблицыПакетов()
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ИмяПакета");
	Таблица.Колонки.Добавить("Название");
	Таблица.Колонки.Добавить("Описание");
	Таблица.Колонки.Добавить("Автор");
	Таблица.Колонки.Добавить("КлючевыеСлова");
	Таблица.Колонки.Добавить("АктуальнаяВерсия");
	Таблица.Колонки.Добавить("АдресРепозитория");
	Возврат Таблица;
КонецФункции

// Полные данные пакета по коду — для страницы деталей.
Функция ДанныеПакетаПоКоду(Знач Код) Экспорт

	Данные = Новый Структура();
	Данные.Вставить("Название");
	Данные.Вставить("Описание");
	Данные.Вставить("Автор");
	Данные.Вставить("КлючевыеСлова");
	Данные.Вставить("ПутьХранения");
	Данные.Вставить("Версии", Новый Массив);
	Данные.Вставить("АктуальнаяВерсия");
	Данные.Вставить("АдресРепозитория");

	Пакет = ХранилищеПакетов.НайтиПоКоду(Код);
	Если Пакет = Неопределено Тогда
		Возврат Данные;
	КонецЕсли;

	Данные.Название = Пакет.Название;
	Данные.Описание = Пакет.Описание;
	Если ЗначениеЗаполнено(Пакет.Автор) Тогда
		Данные.Автор = Пакет.Автор.Имя;
	КонецЕсли;
	Данные.КлючевыеСлова = Пакет.КлючевыеСлова;
	Данные.ПутьХранения = ОбъединитьПути(КонфигурацияХаба.КаталогХраненияПакетов(), КонфигурацияХаба.КаталогПакетов, Пакет.Код);
	Данные.АдресРепозитория = Пакет.СсылкаНаПроект;
	Данные.АктуальнаяВерсия = Пакет.АктуальнаяВерсия;

	Версии = ХранилищеВерсий.Версии(Пакет.Код);
	ТабВерсий = Новый ТаблицаЗначений;
	ТабВерсий.Колонки.Добавить("НомерВерсии");
	ТабВерсий.Колонки.Добавить("ДатаВерсии");
	Для Каждого Версия Из Версии Цикл
		Стр = ТабВерсий.Добавить();
		Стр.НомерВерсии = Версия.Номер;
		Стр.ДатаВерсии = Версия.ДатаОбновления;
	КонецЦикла;

	МассивНомеров = ТабВерсий.ВыгрузитьКолонку("НомерВерсии");
	Попытка
		СортировкаВерсий.СортироватьВерсии(МассивНомеров, "Убыв");
	Исключение
		// сортировка может упасть на нестандартных версиях — оставим неотсортированный список
	КонецПопытки;

	КоллекцияВерсий = Новый Массив;
	Для Каждого Номер Из МассивНомеров Цикл
		Стр = ТабВерсий.Найти(Номер, "НомерВерсии");
		Если Стр = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		КоллекцияВерсий.Добавить(Новый Структура("НомерВерсии, ДатаВерсии", Стр.НомерВерсии, Стр.ДатаВерсии));
	КонецЦикла;
	Данные.Версии = КоллекцияВерсий;

	Возврат Данные;

КонецФункции

Функция ВерсииДляЗагрузки(Знач ДанныеПакета) Экспорт

	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("НомерВерсии");
	Таблица.Колонки.Добавить("ФайлВерсии");
	Таблица.Колонки.Добавить("ДатаВерсии");

	Для Каждого СтрокаВерсии Из ДанныеПакета.Версии Цикл

		Путь = ОбъединитьПути(
			КонфигурацияХаба.КаталогХраненияПакетов(),
			"download",
			ДанныеПакета.Название,
			ДанныеПакета.Название + "-" + СтрокаВерсии.НомерВерсии + ".ospx"
		);

		Файл = Новый Файл(Путь);
		Если Файл.Существует() Тогда
			Стр = Таблица.Добавить();
			Стр.НомерВерсии = СтрокаВерсии.НомерВерсии;
			Стр.ФайлВерсии = "/download/" + ДанныеПакета.Название + "/" + Файл.Имя;
			Стр.ДатаВерсии = СтрокаВерсии.ДатаВерсии;
		КонецЕсли;

	КонецЦикла;

	Возврат Таблица;

КонецФункции

Функция ПолучитьСодержимоеReadme(Знач Путь) Экспорт

	Если ПустаяСтрока(Путь) Тогда
		Возврат "<p>Автор не предоставил файл README</p>";
	КонецЕсли;
	ФайлДокументации = ОбъединитьПути(Путь, "readme.md");
	Если Не ФС.ФайлСуществует(ФайлДокументации) Тогда
		Возврат "<p>Автор не предоставил файл README</p>";
	КонецЕсли;

	Чтение = Новый ЧтениеТекста(ФайлДокументации, КодировкаТекста.UTF8NoBOM);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	// TODO: пока пакет markdown отключён, отдаём raw-текст в <pre>.
	Возврат "<pre>" + Текст + "</pre>";

КонецФункции
