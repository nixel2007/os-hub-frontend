&Пластилин
Перем КонфигурацияХаба;

&Пластилин
Перем СервисПубликации;

&Пластилин
Перем СервисУведомлений;

&Контроллер("/push")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ТочкаМаршрута("")
Процедура Push(Ответ, Запрос, ЗаголовкиЗапроса) Экспорт

	АвторПуша = Неопределено;
	ТокенАвторизации = ЗначениеЗаголовка(ЗаголовкиЗапроса, "OAUTH-TOKEN");
	ИмяФайла = ЗначениеЗаголовка(ЗаголовкиЗапроса, "FILE-NAME");
	Канал = ЗначениеЗаголовка(ЗаголовкиЗапроса, "CHANNEL");

	КаталогПубликации = ОбъединитьПути(КонфигурацияХаба.КаталогПубликации(), КонфигурацияХаба.КаталогПакетов);
	ЭтоТестоваяСборка = НРег(Строка(Канал)) <> "stable";

	Попытка
		СервисПубликации.ПроверитьКорректностьФайла(ИмяФайла);
		ОписаниеПакета = СервисПубликации.ОписаниеПакета(ИмяФайла);
		Пользователь = СервисПубликации.ПользовательGitHubПоТокену(ТокенАвторизации);
		АвторПуша = Пользователь;
		Если Пользователь = Неопределено Тогда
			ВызватьИсключение "Не удалось получить пользователя github по token";
		КонецЕсли;
		Если Не СервисПубликации.ЕстьРазрешениеОтправлятьВРепозиторий(Пользователь.Логин, ОписаниеПакета.Идентификатор) Тогда
			ВызватьИсключение Новый ИнформацияОбОшибке("Пользователь не имеет права отправки в репозиторий пакета", 401);
		КонецЕсли;
	Исключение
		ВернутьОтвет(Ответ, СервисПубликации.ВычислитьКодОшибки(ИнформацияОбОшибке()), "Ошибка: " + ИнформацияОбОшибке().Описание);
		Возврат;
	КонецПопытки;

	Попытка
		ДанныеФайла = СервисПубликации.ДвоичныеДанныеИзЗапроса(Запрос);
		Пакет = СервисПубликации.ЗафиксироватьПакет(КаталогПубликации, ДанныеФайла, ИмяФайла, ОписаниеПакета, ЭтоТестоваяСборка);
	Исключение
		ВернутьОтвет(Ответ, СервисПубликации.ВычислитьКодОшибки(ИнформацияОбОшибке()), "Сохранение пакета: " + ИнформацияОбОшибке().Описание);
		Возврат;
	КонецПопытки;

	Если КонфигурацияХаба.ОтправлятьУведомлениеВТелеграмм Тогда
		СервисУведомлений.УведомитьОРелизе(
			ОписаниеПакета.Идентификатор,
			Пакет.СсылкаНаПроект,
			ОписаниеПакета.Версия,
			АвторПуша
		);
	КонецЕсли;

	ВернутьОтвет(Ответ, 200, "Push accept");

КонецПроцедуры

Процедура ВернутьОтвет(Знач Ответ, Знач КодСостояния, Знач Сообщение)

	Ответ.УстановитьСостояние(КодСостояния);
	Ответ.Заголовки["Content-Type"] = "application/json; charset=utf-8";

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Новый Структура("КодСостояние, Сообщение", КодСостояния, Сообщение));
	Ответ.ТелоТекст = Запись.Закрыть();

КонецПроцедуры

Функция ЗначениеЗаголовка(Знач Заголовки, Знач Имя)
	Если Заголовки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Значение = Заголовки.Получить(Имя);
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Если Значение.Количество() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Значение[0];
	КонецЕсли;
	Возврат Значение;
КонецФункции
