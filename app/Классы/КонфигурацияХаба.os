#Использовать fs

Перем КаталогПакетов Экспорт;
Перем КаталогХраненияПакетов;
Перем КаталогПубликации;
Перем ОтправлятьУведомлениеВТелеграмм Экспорт;
Перем ТокенАвторизацииТелеграмм Экспорт;
Перем ИдентификаторГруппыУведомленияВТелеграмм Экспорт;
Перем ТокенGitHubСупер Экспорт;
Перем ЛогинАдмина Экспорт;
Перем ПарольАдмина Экспорт;

&Желудь
&Прозвище("КонфигурацияХаба")
Процедура ПриСозданииОбъекта()

	КаталогПакетов = "download";

	ОтправлятьУведомлениеВТелеграмм = ПрочитатьБулевоИзСреды("OSHUB_TG_NOTIFICATION");
	ТокенАвторизацииТелеграмм = Строка(ПолучитьПеременнуюСреды("TELEGRAM_TOKEN"));
	ИдентификаторГруппыУведомленияВТелеграмм = Строка(ПолучитьПеременнуюСреды("TELEGRAM_GROUP_ID"));
	ТокенGitHubСупер = Строка(ПолучитьПеременнуюСреды("GITHUB_SUPER_TOKEN"));

	ЛогинАдмина = ?(ПустаяСтрока(ПолучитьПеременнуюСреды("OSHUB_DEFAULT_USER")), "admin", ПолучитьПеременнуюСреды("OSHUB_DEFAULT_USER"));
	ПарольАдмина = ?(ПустаяСтрока(ПолучитьПеременнуюСреды("OSHUB_DEFAULT_PASSWORD")), "admin", ПолучитьПеременнуюСреды("OSHUB_DEFAULT_PASSWORD"));

КонецПроцедуры

Функция КаталогХраненияПакетов() Экспорт
	Если КаталогХраненияПакетов = Неопределено Тогда
		Значение = ПолучитьПеременнуюСреды("OSHUB_BINARY_ROOT");
		Если Не ПустаяСтрока(Значение) Тогда
			ФС.ОбеспечитьКаталог(Значение);
		КонецЕсли;
		КаталогХраненияПакетов = Новый Файл(Значение).ПолноеИмя;
	КонецЕсли;
	Возврат КаталогХраненияПакетов;
КонецФункции

Функция КаталогПубликации() Экспорт
	Если КаталогПубликации = Неопределено Тогда
		Значение = Строка(ПолучитьПеременнуюСреды("PATH_TO_OSCRIPT_HUB"));
		Если ПустаяСтрока(Значение) Тогда
			Значение = "/var/www/hub.oscript.io";
		КонецЕсли;
		КаталогПубликации = Значение;
	КонецЕсли;
	Возврат КаталогПубликации;
КонецФункции

Функция ПрочитатьБулевоИзСреды(Знач Имя)
	Значение = ПолучитьПеременнуюСреды(Имя);
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Нижний = НРег(СокрЛП(Значение));
	Возврат Нижний = "true" Или Нижний = "истина" Или Нижний = "yes" Или Нижний = "да" Или Нижний = "1";
КонецФункции
