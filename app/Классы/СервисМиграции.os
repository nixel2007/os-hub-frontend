#Использовать fs
#Использовать autumn-logos

&Пластилин
Перем КонфигурацияХаба;

&Пластилин
Перем ХранилищеПакетов;

&Пластилин
Перем ХранилищеВерсий;

&Пластилин
Перем ХранилищеАвторов;

&Пластилин
Перем СервисПубликации;

&Лог("oscript.web.hub")
Перем Лог;

Перем ПакетыХаба;
Перем ВерсииПакетовХаба;
Перем Канал;
Перем КартаИмен;

&Желудь
&Прозвище("СервисМиграции")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

Функция ЗапуститьИмпортВБД() Экспорт

	Лог.Информация("Запущена миграция данных");
	Попытка
		ОчиститьБазуДанных();
		ПрочитатьКартуИмен();
		ПодготовитьДанные();
		ЗагрузитьДанные();
	Исключение
		Лог.Ошибка(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;
	Лог.Информация("Завершена миграция данных");
	Возврат Истина;

КонецФункции

Процедура ПрочитатьКартуИмен()
	ФайлКарты = ОбъединитьПути(СтартовыйСценарий().Каталог, "nameRemap.json");
	Если ФС.ФайлСуществует(ФайлКарты) Тогда
		Чтение = Новый ЧтениеJSON;
		Чтение.ОткрытьФайл(ФайлКарты);
		КартаИмен = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Иначе
		КартаИмен = Новый Соответствие;
	КонецЕсли;
КонецПроцедуры

Процедура ПодготовитьДанные()

	ПакетыХаба = Новый ТаблицаЗначений;
	Для Каждого Имя Из СтрРазделить("Имя,ИмяПроекта,Описание,Путь,Автор,КлючевыеСлова,ПутьКОписанию,Проект,АктуальнаяВерсия", ",") Цикл
		ПакетыХаба.Колонки.Добавить(Имя);
	КонецЦикла;

	ВерсииПакетовХаба = Новый ТаблицаЗначений;
	Для Каждого Имя Из СтрРазделить("Имя,Версия,Путь,Зависимости,ДатаСоздания", ",") Цикл
		ВерсииПакетовХаба.Колонки.Добавить(Имя);
	КонецЦикла;

	КаталогХаба = КонфигурацияХаба.КаталогХраненияПакетов();
	Канал = "download";

	СписокПакетов = Новый Массив;
	Элементы = НайтиФайлы(ОбъединитьПути(КаталогХаба, Канал), "*");
	Для Каждого Элемент Из Элементы Цикл
		Если Элемент.ЭтоКаталог() И СписокПакетов.Найти(Элемент.Имя) = Неопределено Тогда
			СписокПакетов.Добавить(Элемент.Имя);
			НовыйПакет = ПакетыХаба.Добавить();
			НовыйПакет.Имя = Элемент.Имя;
			НовыйПакет.Путь = ОбъединитьПути(Канал, НовыйПакет.Имя);
			ИзКарты = КартаИмен[НовыйПакет.Имя];
			НовыйПакет.ИмяПроекта = ?(ИзКарты = Неопределено, НовыйПакет.Имя, ИзКарты);
			Лог.Информация("Найден пакет " + НовыйПакет.Путь);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Пакет Из ПакетыХаба Цикл

		ПутьКМетаданным = ОбъединитьПути(КаталогХаба, Пакет.Путь, "meta.json");
		МетаОписание = Неопределено;
		Если ФС.ФайлСуществует(ПутьКМетаданным) Тогда
			Попытка
				Чтение = Новый ЧтениеJSON;
				Чтение.ОткрытьФайл(ПутьКМетаданным);
				МетаОписание = ПрочитатьJSON(Чтение, Истина);
				Чтение.Закрыть();
			Исключение
				Лог.Ошибка("Не удалось прочитать meta.json пакета " + Пакет.Имя);
			КонецПопытки;
		КонецЕсли;

		Если МетаОписание <> Неопределено Тогда
			Пакет.Описание = МетаОписание.Получить("Описание");
			Пакет.Автор = МетаОписание.Получить("Автор");
			Пакет.КлючевыеСлова = МетаОписание.Получить("КлючевыеСлова");
			Пакет.Проект = МетаОписание.Получить("АдресРепозитория");
			Пакет.АктуальнаяВерсия = МетаОписание.Получить("АктуальнаяВерсия");
		КонецЕсли;

		КаталогПакета = ОбъединитьПути(КаталогХаба, Канал, Пакет.Имя);
		Файлы = НайтиФайлы(КаталогПакета, "*-*.ospx");
		Для Каждого Файл Из Файлы Цикл
			НоваяВерсия = ВерсииПакетовХаба.Добавить();
			НоваяВерсия.Имя = Пакет.Имя;
			НоваяВерсия.Версия = ВерсияИзИмениФайла(НРег(Файл.ИмяБезРасширения), НРег(Пакет.Имя));
			НоваяВерсия.Путь = ОбъединитьПути(Канал, Пакет.Имя, Файл.Имя);
			НоваяВерсия.Зависимости = СервисПубликации.ПрочитатьЗависимостиПакета(Файл.ПолноеИмя);
			НоваяВерсия.ДатаСоздания = Файл.ПолучитьВремяИзменения();
		КонецЦикла;

		ПутьКОписанию = ОбъединитьПути(Канал, Пакет.Имя, "readme.md");
		ФайлОписания = Новый Файл(ОбъединитьПути(КаталогХаба, ПутьКОписанию));
		Если ФайлОписания.Существует() Тогда
			Пакет.ПутьКОписанию = ПутьКОписанию;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура ЗагрузитьДанные()

	Для Каждого СтрокаПакет Из ПакетыХаба Цикл

		Пакет = ХранилищеПакетов.Создать();
		Пакет.Код = СтрокаПакет.Имя;
		Пакет.Название = Пакет.Код;
		Если ЗначениеЗаполнено(СтрокаПакет.Автор) Тогда
			Пакет.Автор = ХранилищеАвторов.НайтиИлиСоздать(СтрокаПакет.Автор);
		КонецЕсли;
		Пакет.Описание = СтрокаПакет.Описание;
		Пакет.КлючевыеСлова = СтрокаПакет.КлючевыеСлова;
		Пакет.ИмяПроекта = СтрокаПакет.ИмяПроекта;
		Пакет.СсылкаНаПроект = СтрокаПакет.Проект;
		Пакет.ПутьКОписанию = СтрокаПакет.ПутьКОписанию;

		ФайлыВерсий = ВерсииПакетовХаба.НайтиСтроки(Новый Структура("Имя", Пакет.Код));
		Если ФайлыВерсий.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		Пакет.Путь = ОбъединитьПути(Канал, Пакет.Код);
		Пакет.АктуальнаяВерсия = СтрокаПакет.АктуальнаяВерсия;
		Пакет.ДатаСоздания = ТекущаяДата();
		Пакет.ДатаОбновления = Пакет.ДатаСоздания;
		ХранилищеПакетов.Сохранить(Пакет);

		Для Каждого СтрокаВерсии Из ФайлыВерсий Цикл
			ВерсияПакета = ХранилищеВерсий.Создать();
			ВерсияПакета.Номер = СтрокаВерсии.Версия;
			ВерсияПакета.Пакет = Пакет.Код;
			ВерсияПакета.Путь = СтрокаВерсии.Путь;
			ВерсияПакета.Зависимости = СоздатьЗависимостиВерсии(СтрокаВерсии.Зависимости);
			ВерсияПакета.ДатаСоздания = СтрокаВерсии.ДатаСоздания;
			ВерсияПакета.ДатаОбновления = СтрокаВерсии.ДатаСоздания;
			ХранилищеВерсий.Сохранить(ВерсияПакета);
		КонецЦикла;

		НоваяАктуальная = СервисПубликации.ОпределитьАктуальнуюВерсию(Пакет.Код);
		Если НоваяАктуальная <> Неопределено Тогда
			Пакет.АктуальнаяВерсия = НоваяАктуальная;
			ХранилищеПакетов.Сохранить(Пакет);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Функция СоздатьЗависимостиВерсии(Знач Зависимости)
	Возврат СервисПубликации.СоздатьЗависимостиВерсии(Зависимости);
КонецФункции

Процедура ОчиститьБазуДанных()
	Лог.Информация("Очистка базы данных не реализована (ручной запуск миграции)");
КонецПроцедуры

Функция ВерсияИзИмениФайла(Знач ИмяФайла, Знач Пакет)
	Возврат СтрЗаменить(ИмяФайла, Пакет + "-", "");
КонецФункции
