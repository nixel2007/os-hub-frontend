#Использовать entity

&Родитель
Перем ХранилищеСущностей;

&ХранилищеСущностей("Пакет")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

Функция НайтиПоКоду(Знач Код) Экспорт
	Возврат ХранилищеСущностей.ПолучитьОдно(Код);
КонецФункции

Функция НайтиПоИмениПроекта(Знач ИмяПроекта) Экспорт
	ОпцииПоиска = Новый ОпцииПоиска();
	ОпцииПоиска.Отбор("ИмяПроекта", ВидСравнения.Равно, ИмяПроекта);
	Результат = ХранилищеСущностей.Получить(ОпцииПоиска);
	Если Результат.Количество() > 0 Тогда
		Возврат Результат[0];
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция Все() Экспорт
	ОпцииПоиска = Новый ОпцииПоиска();
	ОпцииПоиска.СортироватьПо("Название", НаправлениеСортировки.Возр);
	Возврат ХранилищеСущностей.Получить(ОпцииПоиска);
КонецФункции

Процедура Сохранить(Знач Пакет) Экспорт
	ХранилищеСущностей.Сохранить(Пакет);
КонецПроцедуры

Процедура Удалить(Знач Пакет) Экспорт
	ХранилищеСущностей.Удалить(Пакет);
КонецПроцедуры

Функция Создать() Экспорт
	Возврат Новый Пакет;
КонецФункции
