&Пластилин
Перем СервисАвторизации;

&Пластилин
Перем СервисКонтента;

&Пластилин
Перем СервисМиграции;

&Контроллер("/office")
&Отображение(Шаблон = "./app/view/_layout.html", Метод = "ПолучитьМодельМакета")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

Функция ПолучитьМодельМакета() Экспорт
	Возврат Новый Структура("Selected", 0);
КонецФункции

&ТочкаМаршрута("")
&Отображение("./app/view/office_index.html")
Процедура Главная(Ответ, ДанныеСессии) Экспорт
	Если Не СервисАвторизации.Авторизован(ДанныеСессии) Тогда
		Ответ.Перенаправить("/office/login");
		Возврат;
	КонецЕсли;
	Ответ.Модель = Новый Структура(
		"КоличествоПакетов, ИмяПользователя",
		СервисКонтента.ТаблицаПакетов().Количество(),
		ДанныеСессии["ИмяПользователя"]
	);
КонецПроцедуры

&ТочкаМаршрута("login")
&Отображение("./app/view/office_login.html")
Процедура Логин(Ответ, Запрос, ТелоЗапроса, ДанныеСессии) Экспорт

	Ошибка = "";

	Если ВРег(Запрос.МетодЗапроса) = "POST" Тогда
		Параметры = РазобратьФорму(ТелоЗапроса);
		Имя = Параметры["Name"];
		Пароль = Параметры["Password"];

		Если СервисАвторизации.ПроверитьВход(Имя, Пароль) Тогда
			СервисАвторизации.Войти(ДанныеСессии, Имя);
			Ответ.Перенаправить("/office");
			Возврат;
		КонецЕсли;

		Ошибка = "Неверное имя пользователя или пароль";
	КонецЕсли;

	Ответ.Модель = Новый Структура("Ошибка", Ошибка);

КонецПроцедуры

&ТочкаМаршрута("logout")
Процедура Выход(Ответ, ДанныеСессии) Экспорт
	СервисАвторизации.Выйти(ДанныеСессии);
	Ответ.Перенаправить("/office/login");
КонецПроцедуры

&ТочкаМаршрута("MigrationData")
Процедура ЗапуститьМиграцию(Ответ, ДанныеСессии) Экспорт
	Если Не СервисАвторизации.Авторизован(ДанныеСессии) Тогда
		Ответ.Перенаправить("/office/login");
		Возврат;
	КонецЕсли;
	Поток = Новый Поток("ЗапуститьИмпортВБД", СервисМиграции);
	Поток.Запустить();
	Ответ.Перенаправить("/office");
КонецПроцедуры

Функция РазобратьФорму(Знач Тело)
	Результат = Новый Соответствие;
	Если ПустаяСтрока(Тело) Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Пара Из СтрРазделить(Тело, "&", Ложь) Цикл
		Части = СтрРазделить(Пара, "=", Истина);
		Если Части.Количество() = 2 Тогда
			Результат.Вставить(Части[0], РаскодироватьСтроку(Части[1], СпособКодированияСтроки.КодировкаURL));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции
