#Использовать autumn-logos

&Пластилин
Перем КонфигурацияХаба;

&Пластилин
Перем ХранилищеПакетов;

&Лог("oscript.web.hub")
Перем Лог;

&Желудь
&Прозвище("СервисРегламентных")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

Процедура ОбновитьОписаниеВсехПакетов() Экспорт
	Скачиватель = Новый ОбновлятельОписаний();
	Скачиватель.Инициализация(
		ОбъединитьПути(КонфигурацияХаба.КаталогХраненияПакетов(), "download"),
		ХранилищеПакетов,
		КонфигурацияХаба.ТокенGitHubСупер,
		КонфигурацияХаба.КаталогПакетов
	);
	Скачиватель.СоздатьФайлыОписаний();
КонецПроцедуры

// Запускает фоновую задачу, которая раз в 3 часа обновляет описания пакетов.
&ФинальныйШтрих
Процедура ЗапуститьФоновоеОбновление() Экспорт

	Если Не ЗначениеЗаполнено(КонфигурацияХаба.ТокенGitHubСупер) Тогда
		Лог.Информация("Пропускаю запуск фонового обновления описаний — нет токена GitHub");
		Возврат;
	КонецЕсли;

	Поток = Новый Поток("ЦиклОбновления", ЭтотОбъект);
	Поток.Запустить();

КонецПроцедуры

Процедура ЦиклОбновления() Экспорт
	Период = 3 * 60 * 60 * 1000; // 3 часа
	Пока Истина Цикл
		Попытка
			ОбновитьОписаниеВсехПакетов();
		Исключение
			Лог.Ошибка(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		Поток.ТекущийПоток().Приостановить(Период);
	КонецЦикла;
КонецПроцедуры
