#Использовать autumn-logos

&Пластилин
Перем КонфигурацияХаба;

&Пластилин
Перем ХранилищеПакетов;

&Лог("oscript.web.hub")
Перем Лог;

&Желудь
&Прозвище("СервисРегламентных")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

Процедура ОбновитьОписаниеВсехПакетов() Экспорт
	Скачиватель = Новый ОбновлятельОписаний();
	Скачиватель.Инициализация(
		ОбъединитьПути(КонфигурацияХаба.КаталогХраненияПакетов(), "download"),
		ХранилищеПакетов,
		КонфигурацияХаба.ТокенGitHubСупер,
		КонфигурацияХаба.КаталогПакетов
	);
	Скачиватель.СоздатьФайлыОписаний();
КонецПроцедуры

// На запуске разово прогоняем обновление описаний (если задан токен GitHub).
// TODO: восстановить периодический фон — старая реализация на ФоновомЗадании
// OneScript.Web ушла вместе с движком. Можно перенести на autumn-scheduler
// или внешний cron при необходимости.
&ФинальныйШтрих
Процедура РазовоеОбновление() Экспорт

	Если Не ЗначениеЗаполнено(КонфигурацияХаба.ТокенGitHubСупер) Тогда
		Лог.Информация("Пропускаю обновление описаний — нет токена GitHub");
		Возврат;
	КонецЕсли;

	Попытка
		ОбновитьОписаниеВсехПакетов();
	Исключение
		Лог.Ошибка(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры
